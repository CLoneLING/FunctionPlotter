<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则：只带走 DataStore 里的函数与设置。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
